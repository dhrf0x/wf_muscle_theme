<!doctype html>
<html lang="es">
<head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    {{ content_for_header }}
    {{ 'application.css' | asset_url | stylesheet_tag }}
    {{ 'search-cart.css' | asset_url | stylesheet_tag }}
</head>
<!--
  body class = "template-{name}" built from Shopify's {{ template }} object.
  e.g. product → template-product
       customers/login → template-customers-login
  Used by CSS to scope customer-page styles without JS.
-->
<body class="template-{{ template | replace: '/', '-' | downcase }}">
    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main role="main" class="main-content">
        {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    <script src="{{ 'application.js' | asset_url }}" defer></script>
    <script src="{{ 'search-modal.js' | asset_url }}" defer></script>
</body>
</html>
