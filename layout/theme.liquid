<!doctype html>
<html>
<head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    {{ content_for_header }}
    {{ 'application.css' | asset_url | stylesheet_tag }}
</head>
<body>
    <header class="header-gym">
        <nav class="nav-links">
            <a href="#">Mujer</a>
            <a href="#">Hombre</a>
            <a href="#">Accesorios</a>
        </nav>
        
        <div class="logo-centered">
            <a href="/">
                <img src="{{ 'weeklyhow-logo.png' | asset_img_url: 'medium' }}" alt="Logo" style="height: 30px;">
            </a>
        </div>

        <div class="header-actions nav-links" style="justify-content: flex-end;">
            <a href="/search">Buscar</a>
            <a href="/cart">Carrito ({{ cart.item_count }})</a>
        </div>
    </header>

    <main role="main" class="main-content">
        {{ content_for_layout }}
    </main>
</body>
</html>