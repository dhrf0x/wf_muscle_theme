<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-{{ template.name }}">
    {% section 'header' %}
    <main id="MainContent" class="content-for-layout focus-none {% if template.name == 'index' %}index-main{% endif %}" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  </body>
</html>