<!doctype html>
<html>
<head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    {{ content_for_header }}
    {{ 'application.css' | asset_url | stylesheet_tag }}
    {{ 'search-cart.css' | asset_url | stylesheet_tag }}
</head>
<body>
    {% section 'header' %}

    <main role="main" class="main-content">
        {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    <script src="{{ 'search-modal.js' | asset_url }}" defer></script>
</body>
</html>