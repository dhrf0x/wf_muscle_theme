{% if section.settings.show_bar and section.blocks.size > 0 %}
  <section
    class="announcement-bar"
    style="--announcement-bg: {{ section.settings.background_color }}; --announcement-text: {{ section.settings.text_color }}; --announcement-speed: {{ section.settings.scroll_speed }}s;"
    aria-label="Anuncios"
  >
    <div class="announcement-bar__track">
      {% for repeat in (1..2) %}
        <div class="announcement-bar__items" aria-hidden="{% if repeat == 2 %}true{% else %}false{% endif %}">
          {% for block in section.blocks %}
            {% assign message = block.settings.text | strip %}
            {% if message != blank %}
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="announcement-bar__item" {{ block.shopify_attributes }}>
                  {{ message }}
                </a>
              {% else %}
                <span class="announcement-bar__item" {{ block.shopify_attributes }}>{{ message }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Barra de anuncios",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Mostrar barra", "default": true },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Color de texto", "default": "#ffffff" },
    { "type": "range", "id": "scroll_speed", "label": "Velocidad del desplazamiento", "min": 10, "max": 40, "step": 2, "default": 22, "unit": "s" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Anuncio",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis en compras mayores a $999" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [
        { "type": "message" },
        { "type": "message", "settings": { "text": "Nuevos drops cada semana" } }
      ]
    }
  ]
}
{% endschema %}
