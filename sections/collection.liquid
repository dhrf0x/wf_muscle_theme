<div class="collection-grid">
  {% paginate collection.products by 12 %}
    {% for product in collection.products %}
      <div class="product-card">
        <a href="{{ product.url }}">
          <div class="product-card__image">
            {{ product.featured_image | image_url: width: 600, height: 800, crop: 'center' | image_tag }}
          </div>
          <div class="product-card__info">
            <h3>{{ product.title }}</h3>
            <p>{{ product.price | money }}</p>
          </div>
        </a>
      </div>
    {% endfor %}
    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 20px 0;
  }
  @media (min-width: 768px) {
    .collection-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; }
  }
  .product-card a { text-decoration: none; color: inherit; }
  .product-card__image { overflow: hidden; background: #f5f5f5; }
  .product-card__image img { transition: transform 0.5s; }
  .product-card:hover img { transform: scale(1.05); }
  .product-card__info { padding: 10px 0; }
  .product-card__info h3 { font-size: 0.9rem; margin-bottom: 5px; font-weight: 500; text-transform: none; letter-spacing: 0; }
  .product-card__info p { font-weight: 700; font-size: 1rem; }
{% endstylesheet %}