<div class="hero full-width">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero__bg' }}
  {% endif %}

  <div class="hero__overlay">
    <div class="hero__content">
      <h1>{{ section.settings.title }}</h1>
      <a href="{{ section.settings.link }}" class="button">Comprar Ahora</a>
    </div>
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    height: 80vh;
    overflow: hidden;
  }
  .hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.2);
  }
  .hero__content {
    text-align: center;
    color: #ffffff;
  }
  .hero__content h1 {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "title", "label": "Título", "default": "Nueva Colección" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ],
  "presets": [{ "name": "Hero Section" }]
}
{% endschema %}