<section class="product-row">
    <div class="row-header">
        <div>
            <p class="heading-bold label-small">{{ section.settings.label }}</p>
            <h2 class="section-title">{{ section.settings.title }}</h2>
        </div>
        <a href="/collections/all" class="view-all-link">Ver Todo</a>
    </div>

    <div class="product-grid">
        {% for product in collections.all.products limit: 4 %}
            <a href="{{ product.url }}" class="product-card">
                <div class="product-card-image">
                    <img src="{{ product.featured_image | img_url: '800x1000', crop: 'center' }}" alt="{{ product.title }}">
                </div>
                <div class="product-card-info">
                    <p class="product-title">{{ product.title }}</p>
                    <p class="product-price">{{ product.price | money }}</p>
                </div>
            </a>
        {% endfor %}
    </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "title", "label": "Título" },
    { "type": "text", "id": "label", "label": "Etiqueta" }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}