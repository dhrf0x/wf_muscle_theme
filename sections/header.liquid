{% liquid
  assign order = 'logo,menu,localization,search,drawer_search,actions'
  assign rows = 'top,bottom' | split: ','
  assign sticky = 'always'
  assign transparent = 'none'
  if template.name == 'index'
    assign transparent = 'always'
  endif

  capture logo
    content_for 'block', type: '_header-logo', id: 'header-logo'
  endcapture
  capture menu
    content_for 'block', type: '_header-menu', id: 'header-menu'
  endcapture
  capture actions
    render 'header-actions'
  endcapture
  capture search
    render 'search', style: 'modal'
  endcapture
%}

<header-component
  id="header-component"
  class="header {% if transparent == 'always' %}header--transparent{% endif %}"
  sticky="{{ sticky }}"
>
  <div class="header__row">
    <div class="header__columns">
      <div class="header__column">{{ logo }}</div>
      <div class="header__column header__column--center">{{ menu }}</div>
      <div class="header__column header__column--right">
        {{ search }}
        {{ actions }}
      </div>
    </div>
  </div>
</header-component>

{% stylesheet %}
  .header {
    --glass-bg: rgba(255, 255, 255, 0.75);
    --glass-border: rgba(0, 0, 0, 0.1);
    display: block;
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 1000;
    background-color: var(--glass-bg) !important;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--glass-border);
  }

  .header--transparent {
    position: fixed;
  }

  .header__columns {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 70px;
    padding: 0 4rem;
  }

  .header__column--center {
    display: flex;
    justify-content: center;
  }

  .header__column--right {
    display: flex;
    justify-content: flex-end;
    gap: 2rem;
  }

  .header-menu .menu-list {
    display: flex;
    gap: 3rem;
    list-style: none;
  }

  .header-menu .menu-list__link {
    text-transform: uppercase;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: #000;
  }

  @media screen and (max-width: 749px) {
    .header__columns {
      grid-template-columns: 1fr 1fr;
      padding: 0 2rem;
    }
    .header__column--center { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header Muscle",
  "settings": [],
  "presets": [{"name": "Header Muscle"}]
}
{% endschema %}