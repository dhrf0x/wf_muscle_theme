{% liquid
  assign sticky = 'always'
  assign transparent = 'none'
  if template.name == 'index'
    assign transparent = 'always'
  endif

  capture logo
    content_for 'block', type: '_header-logo', id: 'header-logo'
  endcapture
  capture menu
    content_for 'block', type: '_header-menu', id: 'header-menu'
  endcapture
  capture actions
    render 'header-actions'
  endcapture
%}

<header-component id="header-component" class="header-muscle {% if transparent == 'always' %}header--glass{% endif %}">
  <div class="header__container">
    <div class="header__col--left">{{ logo }}</div>
    <div class="header__col--center mobile:hidden">{{ menu }}</div>
    <div class="header__col--right">{{ actions }}</div>
  </div>
</header-component>

{% stylesheet %}
  .header-muscle {
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.72) !important;
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .header--glass { position: fixed; }

  .header__container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 70px;
    padding: 0 4rem;
    max-width: 1440px;
    margin: 0 auto;
  }

  .header__col--center { display: flex; justify-content: center; }
  .header__col--right { display: flex; justify-content: flex-end; gap: 1.5rem; }

  .header-menu .menu-list {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    text-transform: uppercase;
    font-weight: 800;
    font-size: 13px;
  }

  @media screen and (max-width: 749px) {
    .header__container { grid-template-columns: 1fr 1fr; padding: 0 1.5rem; }
    .header__col--center { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header Muscle Glass",
  "settings": [],
  "presets": [{"name": "Header Muscle Glass"}]
}
{% endschema %}