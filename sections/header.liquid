<header class="header-gym" style="--header-bg: {{ section.settings.background_color }}; --header-link-color: {{ section.settings.link_color }};">
  <nav class="header-nav-left">
    <div class="header-custom-links">
      {% for block in section.blocks %}
        {% if block.type == 'custom_link' %}
          <a href="{{ block.settings.url }}" class="header-custom-link" {{ block.shopify_attributes }}>
            {{ block.settings.title }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </nav>

  <div class="header-logo-center">
    <a href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name }}
      {% else %}
        <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}">
      {% endif %}
    </a>
  </div>

  <div class="header-nav-right">
    {% if section.settings.show_theme_toggle %}
      <button type="button" class="theme-toggle" data-theme-toggle>
        <span class="theme-toggle__icon">🌙</span>
        <span class="theme-toggle__label">{{ section.settings.theme_toggle_label }}</span>
      </button>
    {% endif %}
    
    <a href="{{ routes.search_url }}" class="js-open-search">Buscar</a>
    <a href="{{ routes.cart_url }}">Carrito ({{ cart.item_count }})</a>
  </div>
</header>

{% render 'search-modal' %}

{% schema %}
{
  "name": "Encabezado",
  "settings": [
    {
      "type": "header",
      "content": "Configuración Visual"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de la tienda"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Color de los enlaces",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Modo Oscuro/Claro"
    },
    {
      "type": "checkbox",
      "id": "show_theme_toggle",
      "label": "Mostrar selector de tema",
      "default": true
    },
    {
      "type": "text",
      "id": "theme_toggle_label",
      "label": "Etiqueta del botón de tema",
      "default": "Tema"
    }
  ],
  "blocks": [
    {
      "type": "custom_link",
      "name": "Enlace a la izquierda",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Texto del enlace",
          "default": "Nuevo Enlace"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Destino (Link)"
        }
      ]
    }
  ]
}
{% endschema %}