{% comment %}
  Hero Section con Liquid Glass Effects
  Inspirado en diseño moderno y Gymshark
{% endcomment %}

{{ 'glass-effects.css' | asset_url | stylesheet_tag }}
{{ 'gymshark-layout.css' | asset_url | stylesheet_tag }}

{% style %}
  .hero-section-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.height }}vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.gradient }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .hero-background-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
{% endstyle %}

<section class="hero-section-{{ section.id }}">
  {% if section.settings.background_image %}
    <img 
      class="hero-background-{{ section.id }}"
      src="{{ section.settings.background_image | image_url: width: 1920 }}"
      srcset="
        {{ section.settings.background_image | image_url: width: 768 }} 768w,
        {{ section.settings.background_image | image_url: width: 1024 }} 1024w,
        {{ section.settings.background_image | image_url: width: 1440 }} 1440w,
        {{ section.settings.background_image | image_url: width: 1920 }} 1920w
      "
      sizes="100vw"
      alt="{{ section.settings.background_image.alt | escape }}"
      loading="eager"
    >
  {% endif %}

  <div class="container">
    <div class="hero-glass-content" style="max-width: {{ section.settings.content_width }}px;">
      {% if section.settings.eyebrow %}
        <p class="hero-eyebrow" style="
          font-size: {{ section.settings.eyebrow_size }}px;
          color: {{ section.settings.eyebrow_color }};
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 0.1em;
          margin-bottom: 1rem;
        ">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.title %}
        <h1 class="hero-title glass-text-shadow" style="
          font-size: clamp(2rem, 5vw, {{ section.settings.title_size }}px);
          color: {{ section.settings.title_color }};
          font-weight: 900;
          line-height: 1.1;
          letter-spacing: -0.02em;
          margin-bottom: 1.5rem;
        ">
          {{ section.settings.title }}
        </h1>
      {% endif %}

      {% if section.settings.subtitle %}
        <p class="hero-subtitle glass-text-shadow" style="
          font-size: clamp(1rem, 2vw, {{ section.settings.subtitle_size }}px);
          color: {{ section.settings.subtitle_color }};
          line-height: 1.6;
          margin-bottom: 2rem;
        ">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}

      <div class="hero-cta">
        {% if section.settings.button_primary_text %}
          <a 
            href="{{ section.settings.button_primary_link }}" 
            class="btn btn-lg btn-glass-primary"
            style="
              background: {{ section.settings.button_primary_bg }};
              color: {{ section.settings.button_primary_color }};
            "
          >
            {{ section.settings.button_primary_text }}
          </a>
        {% endif %}

        {% if section.settings.button_secondary_text %}
          <a 
            href="{{ section.settings.button_secondary_link }}" 
            class="btn btn-lg btn-glass"
            style="
              color: {{ section.settings.button_secondary_color }};
            "
          >
            {{ section.settings.button_secondary_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Glass",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section height",
      "default": 80
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 700
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "gradient",
      "label": "Gradient overlay",
      "options": [
        {
          "value": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
          "label": "Purple"
        },
        {
          "value": "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
          "label": "Pink"
        },
        {
          "value": "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)",
          "label": "Blue"
        },
        {
          "value": "linear-gradient(135deg, #fa709a 0%, #fee140 100%)",
          "label": "Energy"
        },
        {
          "value": "linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%)",
          "label": "Dark"
        }
      ],
      "default": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 70
    },
    {
      "type": "header",
      "content": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New Collection"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow size",
      "default": 14
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Elevate Your Performance"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Title size (desktop)",
      "default": 72
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover premium fitness apparel designed for champions. Push your limits with style and comfort."
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Subtitle size (desktop)",
      "default": 20
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_primary_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_primary_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_primary_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button_secondary_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_secondary_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero Glass",
      "category": "Hero"
    }
  ]
}
{% endschema %}
