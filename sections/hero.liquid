<div class="hero-full-screen">
  <div class="hero-overlay"></div>
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero-bg-image', loading: 'eager' }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-placeholder' }}
  {% endif %}

  <div class="hero-content">
    <h1 class="hero-title">{{ section.settings.title | upcase }}</h1>
    <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
    <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label | upcase }}</a>
  </div>
</div>

<style>
  .hero-full-screen {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero-bg-image, .hero-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.6) 100%);
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 800px;
    padding: 0 20px;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    margin-bottom: 1rem;
    line-height: 0.9;
    color: #fff;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    margin-bottom: 2.5rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>

{% schema %}
{
  "name": "Hero Muscle Full",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de Fondo" },
    { "type": "text", "id": "title", "label": "Título", "default": "NEW DROP" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Performance lifestyle" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "COMPRAR AHORA" },
    { "type": "url", "id": "button_link", "label": "Link del Botón" }
  ],
  "presets": [{ "name": "Hero Muscle Full" }]
}
{% endschema %}