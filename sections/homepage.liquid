<section class="hero-banner">
    <img src="{{ 'hero-gym-red.jpg' | asset_url }}" class="hero-image">
    <div class="hero-text-overlay">
        <p class="heading-bold">Mujeres</p>
        <h1>LO NUEVO EN ROJO</h1>
        <p>Tus favoritos de siempre, ahora en rojos en tendencia.</p>
        <div class="cta-group">
            <a href="/collections/all" class="btn-white">Comprar Ahora</a>
            <a href="/collections/all" class="btn-white-outline">Shop Red</a>
        </div>
    </div>
</section>

<section class="product-row">
    <div class="row-header">
        <div>
            <p class="heading-bold label-small">Mujeres</p>
            <h2 class="section-title">LO NUEVO EN ROJO</h2>
        </div>
        <a href="/collections/all" class="view-all-link">Ver Todo</a>
    </div>

    <div class="product-grid">
        {% for product in collections.all.products limit: 4 %}
            <a href="{{ product.url }}" class="product-card">
                <div class="product-card-image">
                    <img src="{{ product.featured_image | img_url: '800x1000', crop: 'center' }}" alt="{{ product.title }}">
                </div>
                <div class="product-card-info">
                    <p class="product-title">{{ product.title }}</p>
                    <p class="product-price">{{ product.price | money }}</p>
                </div>
            </a>
        {% endfor %}
    </div>
</section>