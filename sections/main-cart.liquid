<div class="section">
  <h1 class="h1">TU CARRITO</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <ul class="cart-items">
        {% for item in cart.items %}
          <li class="cart-item">
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}">
            <div>
              <h3 style="font-weight: 800;">{{ item.product.title | upcase }}</h3>
              <p>Talla: {{ item.variant.title }}</p>
              <a href="{{ item.url_to_remove }}" style="color: red; text-transform: uppercase; font-size: 11px;">Eliminar</a>
            </div>
            <div style="font-weight: 800;">{{ item.final_line_price | money }}</div>
          </li>
        {% endfor %}
      </ul>
      <div style="text-align: right; padding-top: 3rem;">
        <h2 class="h2">TOTAL: {{ cart.total_price | money }}</h2>
        <button type="submit" name="checkout" class="button" style="max-width: 400px;">FINALIZAR PEDIDO</button>
      </div>
    </form>
  {% else %}
    <p>Tu carrito está vacío.</p>
    <a href="/collections/all" class="button">VER PRODUCTOS</a>
  {% endif %}
</div>