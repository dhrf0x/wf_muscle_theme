<div class="section" style="padding-top: 120px;">
  <h1 class="h1" style="font-weight: 900; border-bottom: 2px solid #fff; padding-bottom: 1rem;">CARRITO</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      <div style="display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem;">
        {% for item in cart.items %}
          <div style="display: grid; grid-template-columns: 80px 1fr auto; gap: 1.5rem; align-items: center; border-bottom: 1px solid #333; padding-bottom: 1.5rem;">
            <img src="{{ item.image | image_url: width: 160 }}" style="width: 100%; aspect-ratio: 2/3; object-fit: cover;">
            <div>
              <h4 style="margin: 0; font-size: 1rem;">{{ item.product.title | upcase }}</h4>
              <p style="margin: 5px 0; font-size: 0.8rem; opacity: 0.5;">{{ item.variant.title }}</p>
              <a href="{{ item.url_to_remove }}" style="color: #ff0000; font-size: 0.7rem; text-transform: uppercase;">Eliminar</a>
            </div>
            <div style="font-weight: 800;">{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>
      <div style="text-align: right; margin-top: 4rem;">
        <h2 style="font-size: 1.5rem;">TOTAL: {{ cart.total_price | money }}</h2>
        <button type="submit" name="checkout" class="button" style="width: 100%; max-width: 400px;">FINALIZAR PEDIDO</button>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 5rem 0;">
      <p>Tu carrito está vacío.</p>
      <a href="/collections/all" class="button">EXPLORAR TIENDA</a>
    </div>
  {% endif %}
</div>