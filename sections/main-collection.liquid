<section class="collection-page" style="--collection-content-max-width: {{ section.settings.content_max_width }}px;">
  <div class="collection-page__container">
    <header class="collection-page__header">
      <p class="collection-page__eyebrow">{{ section.settings.eyebrow_text }}</p>
      <h1 class="collection-page__title">{{ collection.title }}</h1>
      {% if section.settings.show_description and collection.description != blank %}
        <div class="collection-page__description rte">{{ collection.description }}</div>
      {% endif %}
    </header>

    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products_count > 0 %}
        <div class="collection-page__grid">
          {% for product in collection.products %}
            <a href="{{ product.url }}" class="product-card">
              <div class="product-card-image">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 900, height: 1100, crop: 'center' }}" alt="{{ product.title | escape }}">
                {% endif %}
              </div>
              <div class="product-card-info">
                <p class="product-title">{{ product.title }}</p>
                <p class="product-price">{{ product.price | money }}</p>
              </div>
            </a>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="collection-page__pagination" aria-label="Paginación colección">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% else %}
        <p class="collection-page__empty">{{ section.settings.empty_text }}</p>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Colección principal",
  "settings": [
    { "type": "text", "id": "eyebrow_text", "label": "Texto superior", "default": "Colección" },
    { "type": "checkbox", "id": "show_description", "label": "Mostrar descripción", "default": true },
    { "type": "text", "id": "empty_text", "label": "Texto sin productos", "default": "No hay productos disponibles en esta colección." },
    { "type": "range", "id": "products_per_page", "label": "Productos por página", "min": 4, "max": 24, "step": 2, "default": 12 },
    { "type": "range", "id": "content_max_width", "label": "Ancho contenido", "min": 980, "max": 1500, "step": 20, "default": 1240, "unit": "px" }
  ]
}
{% endschema %}
