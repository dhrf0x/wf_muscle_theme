<section class="page-default" style="--collection-content-max-width: {{ section.settings.content_max_width }}px;">
  <h1>{{ page.title }}</h1>
  <div class="rte">{{ page.content }}</div>
</section>

{% schema %}
{
  "name": "Página principal",
  "settings": [
    { "type": "range", "id": "content_max_width", "label": "Ancho contenido", "min": 700, "max": 1400, "step": 20, "default": 1000, "unit": "px" }
  ]
}
{% endschema %}
