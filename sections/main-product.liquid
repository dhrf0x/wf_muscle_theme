{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_image = current_variant.featured_image | default: product.featured_image %}

<section class="product-page" style="--product-content-max-width: {{ section.settings.content_max_width }}px;">
  <div class="product-page__container">
    <div class="product-page__gallery">
      <div class="product-page__featured">
        {% if featured_image != blank %}
          <img src="{{ featured_image | image_url: width: 1200 }}" alt="{{ featured_image.alt | escape }}" id="ProductPhotoImg">
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="product-page__thumbs">
          {% for image in product.images %}
            <a href="{{ image | image_url: width: 1200 }}" class="product-page__thumb" aria-label="Ver imagen {{ forloop.index }}">
              <img src="{{ image | image_url: width: 260 }}" alt="{{ image.alt | escape }}">
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-page__content">
      <p class="product-page__eyebrow">{{ section.settings.eyebrow_text }}</p>
      <h1 class="product-page__title">{{ product.title }}</h1>
      <p class="product-page__price">{{ current_variant.price | money }}</p>

      <form action="/cart/add" method="post" enctype="multipart/form-data" id="AddToCartForm" class="product-form">
        {% if product.variants.size > 1 %}
          <label for="productSelect" class="product-form__label">{{ section.settings.variant_label }}</label>
          <select name="id" id="productSelect" class="product-form__select">
            {% for variant in product.variants %}
              {% if variant.available %}
                <option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>
                  {{ variant.title }} - {{ variant.price | money_with_currency }}
                </option>
              {% else %}
                <option disabled="disabled">{{ variant.title }} - Agotado</option>
              {% endif %}
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endif %}

        <div class="product-form__row">
          <label for="Quantity" class="product-form__label">{{ section.settings.quantity_label }}</label>
          <input type="number" id="Quantity" name="quantity" value="1" min="1" class="product-form__qty">
        </div>

        <button type="submit" name="add" id="AddToCart" class="product-form__submit">{{ section.settings.add_to_cart_text }}</button>
      </form>

      <div class="product-page__description rte">{{ product.description }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto principal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Texto superior",
      "default": "WF Urban Muscle"
    },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Etiqueta de variantes",
      "default": "Selecciona tu talla"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Etiqueta de cantidad",
      "default": "Cantidad"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Texto botón carrito",
      "default": "Añadir al carrito"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 980,
      "max": 1500,
      "step": 20,
      "default": 1250,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Sección principal"
    }
  ]
}
{% endschema %}