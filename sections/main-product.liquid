{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_images = product.images %}

<section class="product-page" style="--product-content-max-width: {{ section.settings.content_max_width }}px;">
  <div class="product-page__container">
    <div class="product-page__gallery" data-product-gallery>
      {% if current_variant.featured_media and current_variant.featured_media.media_type == 'image' %}
        {% assign featured_image = current_variant.featured_media.preview_image %}
      {% elsif current_variant.featured_image %}
        {% assign featured_image = current_variant.featured_image %}
      {% else %}
        {% assign featured_image = product.featured_media.preview_image | default: product.featured_image %}
      {% endif %}

      {% assign active_index = 0 %}
      {% if featured_image %}
        {% for image in product_images %}
          {% if image.id == featured_image.id %}
            {% assign active_index = forloop.index0 %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if product_images.size > 0 %}
        <div class="product-page__gallery-grid">
          {% if product_images.size > 1 %}
            <div class="product-page__thumbs" role="listbox" aria-label="Galería de producto">
              {% for image in product_images %}
                <button
                  type="button"
                  class="product-page__thumb{% if forloop.index0 == active_index %} is-active{% endif %}"
                  data-product-thumb
                  data-image-url="{{ image | image_url: width: 1400 }}"
                  data-image-alt="{{ image.alt | default: product.title | escape }}"
                  data-image-index="{{ forloop.index0 }}"
                  data-image-id="{{ image.id }}"
                  aria-label="Ver imagen {{ forloop.index }}"
                  {% if forloop.index0 == active_index %}aria-current="true"{% endif %}
                >
                  <img src="{{ image | image_url: width: 280 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">
                </button>
              {% endfor %}
            </div>
          {% endif %}

          <div class="product-page__featured-wrap">
            <div class="product-page__featured" data-product-featured>
              {% for image in product_images %}
                <img
                  src="{{ image | image_url: width: 1400 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  data-product-slide
                  data-image-index="{{ forloop.index0 }}"
                  data-image-id="{{ image.id }}"
                  {% unless forloop.index0 == active_index %}hidden{% endunless %}
                  loading="{% if forloop.index0 == active_index %}eager{% else %}lazy{% endif %}"
                >
              {% endfor %}
            </div>

            {% if product_images.size > 1 %}
              <button type="button" class="product-page__gallery-nav product-page__gallery-nav--prev" data-gallery-prev aria-label="Imagen anterior">‹</button>
              <button type="button" class="product-page__gallery-nav product-page__gallery-nav--next" data-gallery-next aria-label="Imagen siguiente">›</button>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="product-page__content">
      {% if section.settings.eyebrow_text != blank %}
        <p class="product-page__eyebrow">{{ section.settings.eyebrow_text }}</p>
      {% endif %}

      <h1 class="product-page__title">{{ product.title }}</h1>
      <p class="product-page__price" data-product-price>{{ current_variant.price | money }}</p>

      {% form 'product', product, class: 'product-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

        {% if product.variants.size > 1 %}
          <label class="product-form__label" for="product-variant-select">{{ section.settings.variant_label }}</label>
          <select id="product-variant-select" class="product-form__select" data-variant-select>
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant.id == current_variant.id %}selected{% endif %}
                data-price="{{ variant.price | money | escape }}"
                {% if variant.featured_image %}data-image-id="{{ variant.featured_image.id }}"{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }}{% unless variant.available %} - Agotado{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% endif %}

        <div class="product-form__qty-wrap">
          <label class="product-form__label" for="product-quantity">{{ section.settings.quantity_label }}</label>
          <div class="quantity-stepper" data-quantity-stepper>
            <button type="button" class="quantity-stepper__btn" data-qty-decrease aria-label="Disminuir cantidad">−</button>
            <input id="product-quantity" class="product-form__qty" type="number" name="quantity" value="1" min="1" inputmode="numeric" pattern="[0-9]*">
            <button type="button" class="quantity-stepper__btn" data-qty-increase aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <button type="submit" name="add" class="product-form__submit">
          {{ section.settings.add_to_cart_text | default: 'Añadir al carrito' }}
        </button>
      {% endform %}

      <div class="product-page__description rte">{{ product.description }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto principal",
  "settings": [
    { "type": "text", "id": "eyebrow_text", "label": "Texto superior", "default": "WF Urban Muscle" },
    { "type": "text", "id": "variant_label", "label": "Etiqueta variante", "default": "Selecciona tu talla" },
    { "type": "text", "id": "quantity_label", "label": "Etiqueta cantidad", "default": "Cantidad" },
    { "type": "text", "id": "add_to_cart_text", "label": "Texto botón", "default": "Añadir al carrito" },
    { "type": "range", "id": "content_max_width", "label": "Ancho", "min": 800, "max": 1600, "default": 1200, "unit": "px" }
  ]
}
{% endschema %}
