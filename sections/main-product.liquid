{% comment %}
  ═══════════════════════════════════════════════════════════════
  WF Urban Muscle — main-product.liquid
  UPLOAD TO: sections/main-product.liquid

  ╔══════════════════════════════════════════════════════════════╗
  ║  BUGS CORREGIDOS vs versión anterior:                       ║
  ║                                                             ║
  ║  BUG 1 (GALERÍA NO SINCRONIZA CON VARIANTE):               ║
  ║  Antes: data-image-id  → JS leía dataset.imageId (undefined)║
  ║  Ahora: data-media-id  → JS lee dataset.mediaId  ✓         ║
  ║  Afectaba: slides, select options, variant pills            ║
  ║                                                             ║
  ║  BUG 2 (ÍNDICE INICIAL INCORRECTO):                        ║
  ║  Antes: gallery div sin data-initial-index                  ║
  ║  Ahora: data-initial-index="{{ active_index }}" en el div   ║
  ║  Arregla: variante preseleccionada vía URL ?variant=xxx     ║
  ╚══════════════════════════════════════════════════════════════╝
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

{% assign product_media = product.media %}
{% assign active_index = 0 %}
{% if current_variant.featured_media %}
  {% assign img_counter = 0 %}
  {% for media in product_media %}
    {% if media.media_type == 'image' %}
      {% if media.id == current_variant.featured_media.id %}
        {% assign active_index = img_counter %}
      {% endif %}
      {% assign img_counter = img_counter | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign image_count = 0 %}
{% for media in product_media %}
  {% if media.media_type == 'image' %}{% assign image_count = image_count | plus: 1 %}{% endif %}
{% endfor %}

<section
  class="product-page"
  style="--product-content-max-width: {{ section.settings.content_max_width }}px;"
>
  <div class="product-page__container">

    <!-- ════ GALERÍA ════ -->
    <div
      class="product-page__gallery"
      data-product-gallery
      data-initial-index="{{ active_index }}"
    >

      {% if image_count > 1 %}
        <div class="product-page__thumbs-sidebar">
          {% assign img_idx = 0 %}
          {% for media in product_media %}
            {% if media.media_type == 'image' %}
              <button
                type="button"
                class="product-page__thumb{% if img_idx == active_index %} is-active{% endif %}"
                data-product-thumb
                data-image-index="{{ img_idx }}"
                data-media-id="{{ media.id }}"
                aria-label="Ver imagen {{ img_idx | plus: 1 }} de {{ image_count }}"
                {% if img_idx == active_index %}aria-current="true"{% endif %}
              >
                <img
                  src="{{ media | image_url: width: 200 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="200"
                >
              </button>
              {% assign img_idx = img_idx | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="product-page__featured-wrap">
        <div class="product-page__featured">
          {% if image_count > 0 %}
            {% assign img_idx = 0 %}
            {% for media in product_media %}
              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  data-product-slide
                  data-image-index="{{ img_idx }}"
                  data-media-id="{{ media.id }}"
                  style="display:none;"
                  loading="{% if img_idx == active_index %}eager{% else %}lazy{% endif %}"
                  width="1400"
                >
                {% assign img_idx = img_idx | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% else %}
            <div class="product-page__no-image">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </div>

        {% if image_count > 1 %}
          <button type="button" class="product-page__gallery-nav product-page__gallery-nav--prev" data-gallery-prev aria-label="Imagen anterior">‹</button>
          <button type="button" class="product-page__gallery-nav product-page__gallery-nav--next" data-gallery-next aria-label="Imagen siguiente">›</button>
        {% endif %}
      </div>

    </div>
    <!-- fin galería -->


    <!-- ════ PANEL DE CONTENIDO ════ -->
    <div class="product-page__content">

      <div class="product-page__top-meta">
        {% if section.settings.eyebrow_text != blank %}
          <p class="product-page__eyebrow">{{ section.settings.eyebrow_text }}</p>
        {% endif %}
        {% if section.settings.badge_text != blank %}
          <span class="product-page__badge">{{ section.settings.badge_text }}</span>
        {% endif %}
      </div>

      <h1 class="product-page__title">{{ product.title }}</h1>

      {% if section.settings.show_star_rating %}
        <p class="product-page__rating">
          <span class="product-page__stars">★★★★★</span>
          {% if section.settings.rating_text != blank %}
            <span>{{ section.settings.rating_text }}</span>
          {% endif %}
        </p>
      {% endif %}

      <div class="product-page__price-row">
        <p class="product-page__price" data-product-price>{{ current_variant.price | money }}</p>
        {% if current_variant.compare_at_price > current_variant.price %}
          <p class="product-page__compare">{{ current_variant.compare_at_price | money }}</p>
        {% endif %}
      </div>

      {% if section.settings.show_inventory_notice %}
        {% if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 10 %}
          <p class="product-page__inventory">Quedan {{ current_variant.inventory_quantity }} unidades.</p>
        {% endif %}
      {% endif %}

      {% form 'product', product, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

        {% if product.variants.size > 1 %}
          <div class="product-form__variants-block">

            <div class="product-form__variant-head">
              <label class="product-form__label" for="product-variant-select">
                {{ section.settings.variant_label }}
              </label>
              {% if section.settings.show_size_guide and section.settings.size_guide_url != blank %}
                <a href="{{ section.settings.size_guide_url }}" class="product-form__size-guide" target="_blank" rel="noopener">
                  {{ section.settings.size_guide_text }}
                </a>
              {% endif %}
            </div>

            <p class="product-form__selected" data-selected-variant>
              {{ section.settings.selected_variant_label }}: {{ current_variant.title }}
            </p>

            <!-- Select oculto — controla el envío del formulario y el JS -->
            <select
              id="product-variant-select"
              name="id"
              data-variant-select
              aria-label="{{ section.settings.variant_label }}"
              style="display:none;"
            >
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant.id == current_variant.id %}selected{% endif %}
                  data-price="{{ variant.price | money | escape }}"
                  data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                  data-title="{{ variant.title | escape }}"
                  data-inventory="{{ variant.inventory_quantity | default: 0 }}"
                  {% if variant.featured_media %}data-media-id="{{ variant.featured_media.id }}"{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }}{% unless variant.available %} – Agotado{% endunless %}
                </option>
              {% endfor %}
            </select>

            <!-- Pills visibles de tallas -->
            <div class="product-form__variant-grid" role="listbox" aria-label="{{ section.settings.variant_label }}">
              {% for variant in product.variants %}
                <button
                  type="button"
                  class="product-form__variant-pill{% if variant.id == current_variant.id %} is-active{% endif %}{% unless variant.available %} is-disabled{% endunless %}"
                  data-variant-option
                  data-variant-id="{{ variant.id }}"
                  {% if variant.featured_media %}data-media-id="{{ variant.featured_media.id }}"{% endif %}
                  {% unless variant.available %}disabled aria-disabled="true"{% endunless %}
                  role="option"
                  aria-selected="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                >
                  {{ variant.title }}
                </button>
              {% endfor %}
            </div>

          </div>
        {% endif %}

        <div class="product-form__buy-row">
          <div class="product-form__qty-wrap">
            <label class="product-form__label" for="product-qty">{{ section.settings.quantity_label }}</label>
            <div class="quantity-stepper" data-quantity-stepper>
              <button type="button" class="quantity-stepper__btn" data-qty-decrease aria-label="Disminuir">−</button>
              <input
                id="product-qty"
                class="product-form__qty"
                type="number"
                name="quantity"
                value="1"
                min="1"
                inputmode="numeric"
                pattern="[0-9]*"
              >
              <button type="button" class="quantity-stepper__btn" data-qty-increase aria-label="Aumentar">+</button>
            </div>
          </div>

          <button type="submit" name="add" class="product-form__submit">
            {{ section.settings.add_to_cart_text | default: 'Añadir al carrito' }}
          </button>
        </div>
      {% endform %}

      {% if section.settings.highlight_text != blank %}
        <p class="product-page__highlight">{{ section.settings.highlight_text }}</p>
      {% endif %}

      {% assign feature_blocks = section.blocks | where: 'type', 'feature' %}
      {% if feature_blocks.size > 0 %}
        <div class="product-page__features">
          {% for block in feature_blocks %}
            <div class="product-page__feature" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="product-page__feature-icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {% endif %}
              <div>
                <p class="product-page__feature-title">{{ block.settings.title }}</p>
                {% if block.settings.text != blank %}
                  <p class="product-page__feature-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% unless product.description == blank %}
        <div class="product-page__description rte">{{ product.description }}</div>
      {% endunless %}

      {% assign detail_blocks = section.blocks | where: 'type', 'detail' %}
      {% if detail_blocks.size > 0 %}
        <div class="product-page__details">
          {% for block in detail_blocks %}
            <details class="product-page__detail" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="product-page__detail-content rte">{{ block.settings.content }}</div>
            </details>
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto principal",
  "settings": [
    { "type": "text",     "id": "eyebrow_text",           "label": "Texto superior",                "default": "WF Urban Muscle" },
    { "type": "text",     "id": "badge_text",             "label": "Badge",                         "default": "NEW DROP" },
    { "type": "checkbox", "id": "show_star_rating",       "label": "Mostrar rating",                "default": true },
    { "type": "text",     "id": "rating_text",            "label": "Texto de rating",               "default": "+320 reseñas verificadas" },
    { "type": "text",     "id": "variant_label",          "label": "Etiqueta variante",             "default": "Selecciona tu talla" },
    { "type": "text",     "id": "selected_variant_label", "label": "Prefijo variante seleccionada", "default": "Seleccionado" },
    { "type": "checkbox", "id": "show_size_guide",        "label": "Mostrar guía de talla",         "default": false },
    { "type": "url",      "id": "size_guide_url",         "label": "URL guía de talla" },
    { "type": "text",     "id": "size_guide_text",        "label": "Texto guía de talla",           "default": "Guía de tallas" },
    { "type": "checkbox", "id": "show_inventory_notice",  "label": "Mostrar aviso de stock bajo",   "default": true },
    { "type": "text",     "id": "quantity_label",         "label": "Etiqueta cantidad",             "default": "Cantidad" },
    { "type": "text",     "id": "add_to_cart_text",       "label": "Texto botón",                   "default": "Añadir al carrito" },
    { "type": "text",     "id": "highlight_text",         "label": "Texto resaltado",               "default": "🚚 Envío express 24/48h · Cambios sin costo" },
    { "type": "range",    "id": "content_max_width",      "label": "Ancho máximo",                  "min": 900, "max": 1700, "default": 1380, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon",  "label": "Icono (emoji)",  "default": "⚡" },
        { "type": "text", "id": "title", "label": "Título",         "default": "Rendimiento premium" },
        { "type": "text", "id": "text",  "label": "Descripción",    "default": "Tejido ligero con ajuste atlético." }
      ]
    },
    {
      "type": "detail",
      "name": "Detalle desplegable",
      "settings": [
        { "type": "text",     "id": "heading", "label": "Título",    "default": "Detalles del producto" },
        { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Composición, fit y cuidados del tejido.</p>" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Producto principal",
      "blocks": [
        { "type": "feature" },
        { "type": "feature", "settings": { "icon": "🧵", "title": "Costuras reforzadas",   "text": "Mayor durabilidad para entrenos intensos." } },
        { "type": "feature", "settings": { "icon": "📦", "title": "Envío rápido",           "text": "Despacho el mismo día hábil." } },
        { "type": "detail" },
        { "type": "detail", "settings": { "heading": "Composición y cuidados", "content": "<p>Algodón premium y elastano. Lavar en frío, secar a la sombra.</p>" } }
      ]
    }
  ]
}
{% endschema %}
