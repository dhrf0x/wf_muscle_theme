<section class="product-page" style="--product-content-max-width: {{ section.settings.content_max_width }}px;">
  <div class="product-page__container">
    <div class="product-page__gallery">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}">
      {% endif %}
    </div>
    <div class="product-page__content">
      <h1>{{ product.title }}</h1>
      <p>{{ product.price | money }}</p>
      
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" class="product-form__submit">Agregar al carrito</button>
      {% endform %}
      
      <div class="rte">{{ product.description }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto principal",
  "settings": [
    { "type": "range", "id": "content_max_width", "label": "Ancho", "min": 800, "max": 1600, "default": 1200 }
  ]
}
{% endschema %}