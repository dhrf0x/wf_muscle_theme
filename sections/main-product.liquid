{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_image = current_variant.featured_image | default: product.featured_image %}

<section class="product-page" style="--product-content-max-width: {{ section.settings.content_max_width }}px;">
  <div class="product-page__container">
    <div class="product-page__gallery">
      <div class="product-page__featured">
        {% if featured_image != blank %}
          <img src="{{ featured_image | image_url: width: 1200 }}" alt="{{ featured_image.alt | escape }}" id="ProductPhotoImg">
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="product-page__thumbs">
          {% for image in product.images %}
            <a href="{{ image | image_url: width: 1200 }}" class="product-page__thumb">
              <img src="{{ image | image_url: width: 260 }}" alt="{{ image.alt | escape }}">
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-page__content">
      <p class="product-page__eyebrow">{{ section.settings.eyebrow_text }}</p>
      <h1 class="product-page__title">{{ product.title }}</h1>
      <p class="product-page__price">{{ current_variant.price | money }}</p>

      <form action="/cart/add" method="post" enctype="multipart/form-data" class="product-form">
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        
        <div class="product-form__row">
           <label class="product-form__label">{{ section.settings.variant_label }}</label>
           <select name="id" class="product-form__select">
             {% for variant in product.variants %}
               <option value="{{ variant.id }}" {% if variant == current_variant %}selected="selected"{% endif %}>
                 {{ variant.title }} - {{ variant.price | money }}
               </option>
             {% endfor %}
           </select>
        </div>

        <div class="product-form__row">
          <label class="product-form__label">{{ section.settings.quantity_label }}</label>
          <input type="number" name="quantity" value="1" min="1" class="product-form__qty">
        </div>

        <button type="submit" name="add" class="product-form__submit">{{ section.settings.add_to_cart_text }}</button>
      </form>

      <div class="product-page__description rte">{{ product.description }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto principal",
  "settings": [
    { "type": "text", "id": "eyebrow_text", "label": "Texto superior", "default": "WF Urban Muscle" },
    { "type": "text", "id": "variant_label", "label": "Etiqueta variante", "default": "Opciones" },
    { "type": "text", "id": "quantity_label", "label": "Etiqueta cantidad", "default": "Cantidad" },
    { "type": "text", "id": "add_to_cart_text", "label": "Botón carrito", "default": "Añadir al carrito" },
    { "type": "range", "id": "content_max_width", "label": "Ancho contenido", "min": 980, "max": 1500, "step": 20, "default": 1250, "unit": "px" }
  ]
}
{% endschema %}