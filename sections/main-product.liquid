{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_images = product.images %}
<section class="product-page" style="--product-content-max-width: {{ section.settings.content_max_width }}px;">
  <div class="product-page__container">
    <div class="product-page__gallery" data-product-gallery>
      {% if current_variant.featured_media and current_variant.featured_media.media_type == 'image' %}
        {% assign featured_image = current_variant.featured_media.preview_image %}
      {% elsif current_variant.featured_image %}
        {% assign featured_image = current_variant.featured_image %}
      {% else %}
        {% assign featured_image = product.featured_media.preview_image | default: product.featured_image %}
      {% endif %}

      {% assign active_index = 0 %}
      {% if featured_image %}
        {% for image in product_images %}
          {% if image.id == featured_image.id %}
            {% assign active_index = forloop.index0 %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if product_images.size > 0 %}
        <div class="product-page__gallery-grid">
          {% if product_images.size > 1 %}
            <div class="product-page__thumbs" role="listbox" aria-label="Galería de producto">
              {% for image in product_images %}
                <button
                  type="button"
                  class="product-page__thumb{% if forloop.index0 == active_index %} is-active{% endif %}"
                  data-product-thumb
                  data-image-index="{{ forloop.index0 }}"
                  data-image-id="{{ image.id }}"
                  aria-label="Ver imagen {{ forloop.index }}"
                  {% if forloop.index0 == active_index %}aria-current="true"{% endif %}
                >
                  <img src="{{ image | image_url: width: 240 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">
                </button>
              {% endfor %}
            </div>
          {% endif %}

          <div class="product-page__featured-wrap">
            <div class="product-page__featured" data-product-featured>
              {% for image in product_images %}
                <img
                  src="{{ image | image_url: width: 1600 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  data-product-slide
                  data-image-index="{{ forloop.index0 }}"
                  data-image-id="{{ image.id }}"
                  {% unless forloop.index0 == active_index %}hidden{% endunless %}
                  loading="{% if forloop.index0 == active_index %}eager{% else %}lazy{% endif %}"
                >
              {% endfor %}
            </div>

            {% if product_images.size > 1 %}
              <button type="button" class="product-page__gallery-nav product-page__gallery-nav--prev" data-gallery-prev aria-label="Imagen anterior">‹</button>
              <button type="button" class="product-page__gallery-nav product-page__gallery-nav--next" data-gallery-next aria-label="Imagen siguiente">›</button>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="product-page__content">
      <div class="product-page__top-meta">
        {% if section.settings.eyebrow_text != blank %}
          <p class="product-page__eyebrow">{{ section.settings.eyebrow_text }}</p>
        {% endif %}

        {% if section.settings.badge_text != blank %}
          <span class="product-page__badge">{{ section.settings.badge_text }}</span>
        {% endif %}
      </div>

      <h1 class="product-page__title">{{ product.title }}</h1>

      {% if section.settings.show_star_rating %}
        <p class="product-page__rating" aria-label="Calificación destacada">
          <span class="product-page__stars">★★★★★</span>
          {% if section.settings.rating_text != blank %}
            <span>{{ section.settings.rating_text }}</span>
          {% endif %}
        </p>
      {% endif %}

      <div class="product-page__price-row">
        <p class="product-page__price" data-product-price>{{ current_variant.price | money }}</p>
        {% if current_variant.compare_at_price > current_variant.price %}
          <p class="product-page__compare">{{ current_variant.compare_at_price | money }}</p>
        {% endif %}
      </div>

      {% if section.settings.show_inventory_notice and current_variant.inventory_quantity > 0 %}
        <p class="product-page__inventory">Quedan {{ current_variant.inventory_quantity }} unidades disponibles.</p>
      {% endif %}

      {% form 'product', product, class: 'product-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

        {% if product.variants.size > 1 %}
          <div class="product-form__variant-head">
            <label class="product-form__label">{{ section.settings.variant_label }}</label>
            {% if section.settings.show_size_guide and section.settings.size_guide_url != blank %}
              <a href="{{ section.settings.size_guide_url }}" class="product-form__size-guide">{{ section.settings.size_guide_text }}</a>
            {% endif %}
          </div>

          <p class="product-form__selected" data-selected-variant>{{ section.settings.selected_variant_label }}: {{ current_variant.title }}</p>

          <select id="product-variant-select" class="product-form__select visually-hidden" data-variant-select>
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant.id == current_variant.id %}selected{% endif %}
                data-price="{{ variant.price | money | escape }}"
                data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                data-title="{{ variant.title | escape }}"
                data-inventory="{{ variant.inventory_quantity | default: 0 }}"
                {% if variant.featured_image %}data-image-id="{{ variant.featured_image.id }}"{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }}{% unless variant.available %} - Agotado{% endunless %}
              </option>
            {% endfor %}
          </select>

          <div class="product-form__variant-grid" role="listbox" aria-label="{{ section.settings.variant_label }}" data-variant-grid>
            {% for variant in product.variants %}
              <button
                type="button"
                class="product-form__variant-pill{% if variant.id == current_variant.id %} is-active{% endif %}{% unless variant.available %} is-disabled{% endunless %}"
                data-variant-option
                data-variant-id="{{ variant.id }}"
                {% if variant.featured_image %}data-image-id="{{ variant.featured_image.id }}"{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}

        <div class="product-form__buy-row">
          <div class="product-form__qty-wrap">
            <label class="product-form__label" for="product-quantity">{{ section.settings.quantity_label }}</label>
            <div class="quantity-stepper" data-quantity-stepper>
              <button type="button" class="quantity-stepper__btn" data-qty-decrease aria-label="Disminuir cantidad">−</button>
              <input id="product-quantity" class="product-form__qty" type="number" name="quantity" value="1" min="1" inputmode="numeric" pattern="[0-9]*">
              <button type="button" class="quantity-stepper__btn" data-qty-increase aria-label="Aumentar cantidad">+</button>
            </div>
          </div>

          <button type="submit" name="add" class="product-form__submit">
            {{ section.settings.add_to_cart_text | default: 'Añadir al carrito' }}
          </button>
        </div>
      {% endform %}

      {% if section.settings.highlight_text != blank %}
        <p class="product-page__highlight">{{ section.settings.highlight_text }}</p>
      {% endif %}

      {% assign feature_blocks = section.blocks | where: 'type', 'feature' %}
      {% if feature_blocks.size > 0 %}
        <div class="product-page__features" role="list">
          {% for block in feature_blocks %}
            <div class="product-page__feature" role="listitem" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="product-page__feature-icon">{{ block.settings.icon }}</span>
              {% endif %}
              <div>
                <p class="product-page__feature-title">{{ block.settings.title }}</p>
                {% if block.settings.text != blank %}
                  <p class="product-page__feature-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="product-page__description rte">{{ product.description }}</div>

      {% assign details_blocks = section.blocks | where: 'type', 'detail' %}
      {% if details_blocks.size > 0 %}
        <div class="product-page__details">
          {% for block in details_blocks %}
            <details class="product-page__detail" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="product-page__detail-content rte">{{ block.settings.content }}</div>
            </details>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto principal",
  "settings": [
    { "type": "text", "id": "eyebrow_text", "label": "Texto superior", "default": "WF Urban Muscle" },
    { "type": "text", "id": "badge_text", "label": "Badge destacado", "default": "NEW DROP" },
    { "type": "checkbox", "id": "show_star_rating", "label": "Mostrar rating visual", "default": true },
    { "type": "text", "id": "rating_text", "label": "Texto de rating", "default": "+320 reseñas verificadas" },
    { "type": "text", "id": "variant_label", "label": "Etiqueta variante", "default": "Selecciona tu talla" },
    { "type": "text", "id": "selected_variant_label", "label": "Prefijo variante seleccionada", "default": "Seleccionado" },
    { "type": "checkbox", "id": "show_size_guide", "label": "Mostrar guía de talla", "default": true },
    { "type": "url", "id": "size_guide_url", "label": "URL guía de talla" },
    { "type": "text", "id": "size_guide_text", "label": "Texto guía de talla", "default": "Guía de tallas" },
    { "type": "checkbox", "id": "show_inventory_notice", "label": "Mostrar aviso de stock", "default": true },
    { "type": "text", "id": "quantity_label", "label": "Etiqueta cantidad", "default": "Cantidad" },
    { "type": "text", "id": "add_to_cart_text", "label": "Texto botón", "default": "Añadir al carrito" },
    { "type": "text", "id": "highlight_text", "label": "Texto resaltado", "default": "🚚 Envío express 24/48h + cambios fáciles" },
    { "type": "range", "id": "content_max_width", "label": "Ancho", "min": 900, "max": 1700, "default": 1320, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature visual",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icono (emoji o texto)", "default": "⚡" },
        { "type": "text", "id": "title", "label": "Título", "default": "Rendimiento premium" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Tejido ligero con ajuste atlético." }
      ]
    },
    {
      "type": "detail",
      "name": "Detalle desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Detalles del producto" },
        { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Configura composición, fit, cuidados o envío desde el admin.</p>" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Producto principal",
      "blocks": [
        { "type": "feature" },
        { "type": "feature", "settings": { "icon": "🧵", "title": "Costuras reforzadas", "text": "Mayor durabilidad para entrenos intensos." } },
        { "type": "feature", "settings": { "icon": "📦", "title": "Envío rápido", "text": "Despacho el mismo día hábil." } },
        { "type": "detail" },
        { "type": "detail", "settings": { "heading": "Composición y cuidados", "content": "<p>Algodón premium y elastano. Lavar en frío y secar a la sombra.</p>" } }
      ]
    }
  ]
}
{% endschema %}
