{% comment %}
  Enhanced Product Card con Glass Effects y Quick Add
  
  Uso:
  {% render 'product-card-enhanced', 
    product: product,
    show_quick_add: true,
    show_second_image: true,
    image_ratio: 'portrait'
  %}
{% endcomment %}

{% liquid
  assign show_quick_add = show_quick_add | default: true
  assign show_second_image = show_second_image | default: true
  assign image_ratio = image_ratio | default: 'portrait'
  assign lazy_load = lazy_load | default: true
  
  if product.featured_media
    assign featured_media = product.featured_media
  endif
  
  if show_second_image and product.media.size > 1
    assign second_media = product.media[1]
  endif
  
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  
  assign sold_out = true
  if product.available
    assign sold_out = false
  endif
%}

<div class="product-card-glass" data-product-id="{{ product.id }}">
  {%- comment -%} Product Link {%- endcomment -%}
  <a href="{{ product.url }}" class="product-card-link">
    
    {%- comment -%} Image Container {%- endcomment -%}
    <div class="product-card-image-wrapper {% if image_ratio == 'portrait' %}aspect-3-4{% elsif image_ratio == 'square' %}aspect-1-1{% endif %}">
      {% if featured_media %}
        <img
          class="product-card-image product-card-image-primary"
          src="{{ featured_media | image_url: width: 600 }}"
          srcset="
            {{ featured_media | image_url: width: 300 }} 300w,
            {{ featured_media | image_url: width: 400 }} 400w,
            {{ featured_media | image_url: width: 600 }} 600w,
            {{ featured_media | image_url: width: 800 }} 800w
          "
          sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
          alt="{{ featured_media.alt | escape }}"
          {% if lazy_load %}loading="lazy"{% endif %}
          width="{{ featured_media.width }}"
          height="{{ featured_media.height }}"
        >
        
        {% if show_second_image and second_media %}
          <img
            class="product-card-image product-card-image-secondary"
            src="{{ second_media | image_url: width: 600 }}"
            srcset="
              {{ second_media | image_url: width: 300 }} 300w,
              {{ second_media | image_url: width: 400 }} 400w,
              {{ second_media | image_url: width: 600 }} 600w,
              {{ second_media | image_url: width: 800 }} 800w
            "
            sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
            alt="{{ second_media.alt | escape }}"
            loading="lazy"
            width="{{ second_media.width }}"
            height="{{ second_media.height }}"
          >
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
      
      {%- comment -%} Badges {%- endcomment -%}
      {% if sold_out %}
        <span class="product-badge-glass sold-out">Sold Out</span>
      {% elsif on_sale %}
        {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
        <span class="product-badge-glass sale">-{{ savings }}%</span>
      {% elsif product.tags contains 'new' or product.tags contains 'New' %}
        <span class="product-badge-glass new">New</span>
      {% endif %}
      
      {%- comment -%} Wishlist Button {%- endcomment -%}
      <button 
        type="button" 
        class="product-wishlist-btn glass-subtle"
        data-product-id="{{ product.id }}"
        aria-label="Add to wishlist"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>
    </div>
    
    {%- comment -%} Product Info {%- endcomment -%}
    <div class="product-card-info">
      {%- comment -%} Vendor {%- endcomment -%}
      {% if product.vendor != blank %}
        <p class="product-card-vendor">{{ product.vendor }}</p>
      {% endif %}
      
      {%- comment -%} Title {%- endcomment -%}
      <h3 class="product-card-title">{{ product.title | escape }}</h3>
      
      {%- comment -%} Reviews (if app installed) {%- endcomment -%}
      <div class="product-card-reviews">
        <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
      </div>
      
      {%- comment -%} Price {%- endcomment -%}
      <div class="product-card-price">
        <span class="product-card-price-current">
          {{ product.price | money }}
        </span>
        {% if on_sale %}
          <span class="product-card-price-original">
            {{ product.compare_at_price | money }}
          </span>
        {% endif %}
      </div>
      
      {%- comment -%} Color Swatches (if variants by color) {%- endcomment -%}
      {% if product.has_only_default_variant == false %}
        {% for option in product.options_with_values %}
          {% if option.name == 'Color' or option.name == 'Colour' %}
            <div class="product-card-swatches">
              {% for value in option.values limit: 5 %}
                <button 
                  type="button" 
                  class="swatch-btn"
                  data-value="{{ value | escape }}"
                  title="{{ value | escape }}"
                  style="background-color: {{ value | downcase | replace: ' ', '-' }};"
                >
                  <span class="sr-only">{{ value }}</span>
                </button>
              {% endfor %}
              {% if option.values.size > 5 %}
                <span class="swatch-more">+{{ option.values.size | minus: 5 }}</span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </a>
  
  {%- comment -%} Quick Add Button {%- endcomment -%}
  {% if show_quick_add and product.available %}
    {% if product.has_only_default_variant %}
      <form action="/cart/add" method="post" class="product-card-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button 
          type="submit" 
          class="product-card-quick-add btn-glass-primary"
          {% if sold_out %}disabled{% endif %}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          Quick Add
        </button>
      </form>
    {% else %}
      <button 
        type="button" 
        class="product-card-quick-add btn-glass-primary"
        data-product-id="{{ product.id }}"
        data-action="quick-view"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        Quick View
      </button>
    {% endif %}
  {% elsif sold_out %}
    <button 
      type="button" 
      class="product-card-quick-add btn-glass-primary"
      disabled
    >
      Sold Out
    </button>
  {% endif %}
</div>

<style>
  .product-card-image-secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  
  .product-card-glass:hover .product-card-image-secondary {
    opacity: 1;
  }
  
  .product-card-vendor {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  
  .product-card-reviews {
    margin-bottom: 0.5rem;
    min-height: 20px;
  }
  
  .product-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  
  .product-card-form {
    padding: 0 1rem 1rem;
  }
  
  .product-wishlist-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.9);
    transition: all 200ms ease;
    z-index: 10;
  }
  
  .product-card-glass:hover .product-wishlist-btn {
    opacity: 1;
    transform: scale(1);
  }
  
  .product-wishlist-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  
  .product-wishlist-btn.active {
    color: #ef4444;
  }
  
  .product-wishlist-btn.active svg {
    fill: currentColor;
  }
  
  .product-card-swatches {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.75rem;
  }
  
  .swatch-btn {
    width: 24px;
    height: 24px;
    border: 2px solid #e5e5e5;
    border-radius: 50%;
    cursor: pointer;
    transition: all 150ms ease;
    padding: 0;
    position: relative;
  }
  
  .swatch-btn:hover {
    border-color: #000;
    transform: scale(1.1);
  }
  
  .swatch-more {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }
  
  .aspect-3-4 {
    aspect-ratio: 3 / 4;
  }
  
  .aspect-1-1 {
    aspect-ratio: 1 / 1;
  }
  
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  // Wishlist functionality
  document.querySelectorAll('.product-wishlist-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      btn.classList.toggle('active');
      
      // Add your wishlist logic here
      const productId = btn.dataset.productId;
      console.log('Toggle wishlist for product:', productId);
    });
  });
  
  // Quick view functionality
  document.querySelectorAll('[data-action="quick-view"]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      const productId = btn.dataset.productId;
      // Open quick view modal
      console.log('Open quick view for product:', productId);
      // Implement your quick view modal logic here
    });
  });
</script>
