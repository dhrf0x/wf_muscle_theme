{% comment %}
  Product Card - Improved Version
  
  Usage:
    {% render 'product-card-improved', product: product, show_quick_add: true %}
    
  Parameters:
    - product: Product object (required)
    - show_quick_add: boolean (default: false)
    - image_ratio: 'portrait' | 'square' (default: 'portrait')
    - show_secondary_image: boolean (default: true)
    - show_vendor: boolean (default: false)
    - lazy_load: boolean (default: true)
{% endcomment %}

{%- liquid
  assign ratio = image_ratio | default: 'portrait'
  assign show_quick_add = show_quick_add | default: false
  assign show_secondary_image = show_secondary_image | default: true
  assign show_vendor = show_vendor | default: false
  assign lazy_load = lazy_load | default: true
  
  assign product_card_product = product
  assign featured_media = product_card_product.featured_media
  assign secondary_media = product_card_product.media[1]
-%}

<div class="product-card" data-product-id="{{ product_card_product.id }}">
  <div class="product-card__link-wrapper">
    <a 
      href="{{ product_card_product.url }}" 
      class="product-card__link"
      aria-label="{{ product_card_product.title | escape }}"
    >
      <div class="product-card__image-container {% if ratio == 'square' %}product-card__image-container--square{% endif %}">
        {%- if product_card_product.featured_media -%}
          {%- liquid
            assign image_alt = featured_media.alt | default: product_card_product.title | escape
            assign image_class = 'product-card__image'
            
            if show_secondary_image and secondary_media
              assign image_class = image_class | append: ' product-card__image--primary'
            endif
          -%}
          
          <img
            srcset="
              {%- if featured_media.width >= 165 -%}{{ featured_media | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if featured_media.width >= 360 -%}{{ featured_media | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if featured_media.width >= 533 -%}{{ featured_media | image_url: width: 533 }} 533w,{%- endif -%}
              {%- if featured_media.width >= 720 -%}{{ featured_media | image_url: width: 720 }} 720w,{%- endif -%}
              {%- if featured_media.width >= 940 -%}{{ featured_media | image_url: width: 940 }} 940w,{%- endif -%}
              {%- if featured_media.width >= 1066 -%}{{ featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
              {{ featured_media | image_url }} {{ featured_media.width }}w
            "
            src="{{ featured_media | image_url: width: 533 }}"
            sizes="(min-width: 1200px) calc((100vw - 10rem) / 5), (min-width: 990px) calc((100vw - 8rem) / 4), (min-width: 750px) calc((100vw - 6rem) / 3), calc((100vw - 4rem) / 2)"
            alt="{{ image_alt }}"
            class="{{ image_class }}"
            {% if lazy_load %}loading="lazy"{% endif %}
            width="{{ featured_media.width }}"
            height="{{ featured_media.height }}"
          >
          
          {%- if show_secondary_image and secondary_media -%}
            <img
              srcset="
                {%- if secondary_media.width >= 165 -%}{{ secondary_media | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if secondary_media.width >= 360 -%}{{ secondary_media | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if secondary_media.width >= 533 -%}{{ secondary_media | image_url: width: 533 }} 533w,{%- endif -%}
                {%- if secondary_media.width >= 720 -%}{{ secondary_media | image_url: width: 720 }} 720w,{%- endif -%}
                {{ secondary_media | image_url }} {{ secondary_media.width }}w
              "
              src="{{ secondary_media | image_url: width: 533 }}"
              sizes="(min-width: 1200px) calc((100vw - 10rem) / 5), (min-width: 990px) calc((100vw - 8rem) / 4), (min-width: 750px) calc((100vw - 6rem) / 3), calc((100vw - 4rem) / 2)"
              alt="{{ secondary_media.alt | default: product_card_product.title | escape }}"
              class="product-card__image product-card__image--secondary"
              loading="lazy"
              width="{{ secondary_media.width }}"
              height="{{ secondary_media.height }}"
            >
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        
        {%- if product_card_product.available == false -%}
          <div class="product-card__badge product-card__badge--sold-out">
            {{ 'products.product.sold_out' | t }}
          </div>
        {%- elsif product_card_product.compare_at_price > product_card_product.price -%}
          <div class="product-card__badge product-card__badge--sale">
            {%- liquid
              assign discount = product_card_product.compare_at_price | minus: product_card_product.price
              assign discount_percent = discount | times: 100.0 | divided_by: product_card_product.compare_at_price | round
            -%}
            -{{ discount_percent }}%
          </div>
        {%- endif -%}
      </div>
      
      <div class="product-card__info">
        {%- if show_vendor and product_card_product.vendor != blank -%}
          <div class="product-card__vendor">
            {{ product_card_product.vendor | escape }}
          </div>
        {%- endif -%}
        
        <h3 class="product-card__title">
          {{ product_card_product.title | escape }}
        </h3>
        
        <div class="product-card__price">
          {%- if product_card_product.price_varies -%}
            <span class="product-card__price-from">{{ 'products.product.from' | t }}</span>
          {%- endif -%}
          
          <span class="product-card__price-amount {% if product_card_product.compare_at_price > product_card_product.price %}product-card__price--sale{% endif %}">
            {{ product_card_product.price | money }}
          </span>
          
          {%- if product_card_product.compare_at_price > product_card_product.price -%}
            <span class="product-card__price--compare">
              {{ product_card_product.compare_at_price | money }}
            </span>
          {%- endif -%}
        </div>
        
        {%- if product_card_product.metafields.reviews.rating.value != blank -%}
          <div class="product-card__reviews">
            <span class="product-card__rating" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product_card_product.metafields.reviews.rating.value, rating_max: product_card_product.metafields.reviews.rating.value.scale_max }}">
              {%- liquid
                assign rating_decimal = 0
                assign decimal = product_card_product.metafields.reviews.rating.value.rating | modulo: 1
                if decimal >= 0.3 and decimal <= 0.7
                  assign rating_decimal = 0.5
                elsif decimal > 0.7
                  assign rating_decimal = 1
                endif
              -%}
              <span class="product-card__rating-value">{{ product_card_product.metafields.reviews.rating.value }} / {{ product_card_product.metafields.reviews.rating.value.scale_max }}</span>
              <span class="product-card__rating-count">({{ product_card_product.metafields.reviews.rating_count }})</span>
            </span>
          </div>
        {%- endif -%}
      </div>
    </a>
    
    {%- if show_quick_add and product_card_product.available -%}
      <div class="product-card__quick-add">
        {%- if product_card_product.variants.size == 1 -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="product-card__form">
            <input type="hidden" name="id" value="{{ product_card_product.variants.first.id }}">
            <button
              type="submit"
              class="button button--full-width"
              aria-label="{{ 'products.product.add_to_cart' | t }}"
            >
              {% render 'icon', icon: 'add-to-cart' %}
              <span>{{ 'products.product.add_to_cart' | t }}</span>
            </button>
          </form>
        {%- else -%}
          <button
            type="button"
            class="button button--full-width"
            data-product-url="{{ product_card_product.url }}"
            aria-label="{{ 'products.product.choose_options' | t }}"
          >
            {{ 'products.product.choose_options' | t }}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
