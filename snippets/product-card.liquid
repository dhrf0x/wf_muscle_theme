<div class="product-card">
  <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
    <div class="product-card__image-container">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div class="product-card__content">
      <h3 class="product-card__title">{{ product.title | upcase }}</h3>
      <div class="product-card__price">{{ product.price | money }}</div>
    </div>
  </a>
</div>