<div class="product-card" style="border-radius: 0; text-align: center;">
  <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
    <div class="product-card__image" style="overflow: hidden; background: #f9f9f9;">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', style: 'width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 0;' }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div class="product-card__content" style="padding: 1.5rem 0;">
      <h3 style="margin: 0; font-size: 1.2rem; font-weight: 800;">{{ product.title | upcase }}</h3>
      <div style="margin-top: 0.5rem; font-size: 1.1rem; opacity: 0.8;">{{ product.price | money }}</div>
    </div>
  </a>
</div>