<div class="product-card">
  <div class="product-card__image-wrapper">
    {{ image_content }}
  </div>
  <div
    class="product-card__content"
    style="text-align: center; padding-top: 20px; display: flex; flex-direction: column; gap: 8px;"
  >
    <h3 class="product-card__title" style="margin: 0; font-size: 1.4rem; font-weight: 800;">
      {{ product.title | uppercase }}
    </h3>
    <div class="product-card__price" style="font-size: 1.2rem; opacity: 0.8;">
      {{ product.price | money }}
    </div>
  </div>
</div>