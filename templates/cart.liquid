<section class="cart-page">
  <div class="cart-page__container">
    <h1 class="cart-page__title">{{ 'templates.cart.cart' | t | default: 'Carrito' }}</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">
                <img src="{{ item.image | image_url: width: 280 }}" alt="{{ item.title | escape }}">
              </a>

              <div class="cart-item__content">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="cart-item__price">{{ item.final_line_price | money }}</p>

                <div class="cart-item__actions">
                  <label for="updates_{{ item.key }}">Cantidad</label>
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Eliminar</a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-summary">
          <p>Subtotal: <strong>{{ cart.total_price | money }}</strong></p>
          <div class="cart-summary__buttons">
            <button type="submit" name="update" class="btn-white-outline">Actualizar</button>
            <button type="submit" name="checkout" class="btn-white">Finalizar compra</button>
          </div>
        </div>
      </form>
    {% else %}
      <p class="search-empty">Tu carrito está vacío.</p>
    {% endif %}
  </div>
</section>
