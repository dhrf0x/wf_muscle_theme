<section class="cart-page">
  <div class="cart-page__container">
    <header class="cart-page__header">
      <p class="collection-page__eyebrow">Resumen</p>
      <h1 class="cart-page__title">{{ 'templates.cart.cart' | t | default: 'Carrito' }}</h1>
      <p class="cart-page__subtitle">Revisa tus productos antes de finalizar tu compra.</p>
    </header>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-layout">
        <div class="cart-items">
          {% for item in cart.items %}
            <article class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">
                <img src="{{ item.image | image_url: width: 360 }}" alt="{{ item.title | escape }}">
              </a>

              <div class="cart-item__content">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {% endunless %}

                <div class="cart-item__meta">
                  <p class="cart-item__price">{{ item.final_price | money }}</p>
                  <p class="cart-item__line">Total: {{ item.final_line_price | money }}</p>
                </div>

                <div class="cart-item__actions">
                  <label for="updates_{{ item.key }}">Cantidad</label>
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item__remove">Eliminar</a>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        <aside class="cart-summary">
          <p class="cart-summary__label">Subtotal</p>
          <p class="cart-summary__total">{{ cart.total_price | money }}</p>
          <p class="cart-summary__note">Impuestos y envío se calculan al finalizar compra.</p>
          <div class="cart-summary__buttons">
            <button type="submit" name="update" class="btn-white-outline">Actualizar</button>
            <button type="submit" name="checkout" class="btn-white">Finalizar compra</button>
          </div>
        </aside>
      </form>
    {% else %}
      <div class="cart-page__empty">
        <p class="search-empty">Tu carrito está vacío.</p>
        <a href="/collections/all" class="btn-white">Ver productos</a>
      </div>
    {% endif %}
  </div>
</section>
