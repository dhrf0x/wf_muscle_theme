{% paginate collection.products by 12 %}
  <section class="collection-page">
    <div class="collection-page__container">
      <header class="collection-page__header">
        <p class="collection-page__eyebrow">Colecciones</p>
        <h1 class="collection-page__title">{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <div class="collection-page__description">{{ collection.description }}</div>
        {% endif %}
      </header>

      <div class="collection-categories">
        <h2 class="collection-categories__title">Categorías</h2>
        <div class="collection-categories__grid">
          {% for cat in collections %}
            {% unless cat.handle == 'frontpage' %}
              <a href="{{ cat.url }}" class="collection-categories__item{% if cat.handle == collection.handle %} is-active{% endif %}">
                <span>{{ cat.title }}</span>
              </a>
            {% endunless %}
          {% endfor %}
        </div>
      </div>

      <div class="collection-products-grid">
        {% for product in collection.products %}
          <a href="{{ product.url | within: collection }}" class="product-card product-card--collection">
            <div class="product-card-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 720 }}" alt="{{ product.featured_image.alt | escape }}">
              {% endif %}
            </div>
            <div class="product-card-info">
              <p class="product-title">{{ product.title }}</p>
              <p class="product-price">{{ product.price | money }}</p>
            </div>
          </a>
        {% else %}
          <p class="search-empty">No hay productos disponibles en esta colección.</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="collection-page__pagination">{{ paginate | default_pagination }}</div>
      {% endif %}
    </div>
  </section>
{% endpaginate %}
