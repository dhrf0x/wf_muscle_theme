<section class="customer-auth customer-auth--login">
  <div class="customer-auth__card">
    <h1 class="customer-auth__title">Iniciar sesión</h1>

    {% form 'customer_login', class: 'customer-auth__form' %}
      {{ form.errors | default_errors }}

      <div class="customer-auth__field">
        <label for="customer_email">Correo electrónico</label>
        <input id="customer_email" type="email" name="customer[email]" autocomplete="email" required>
      </div>

      <div class="customer-auth__field">
        <label for="customer_password">Contraseña</label>
        <input id="customer_password" type="password" name="customer[password]" autocomplete="current-password" required>
      </div>

      <button type="submit" class="customer-auth__submit">Entrar</button>
    {% endform %}

    <details class="customer-auth__recover">
      <summary>¿Olvidaste tu contraseña?</summary>
      {% form 'recover_customer_password', class: 'customer-auth__form' %}
        {{ form.errors | default_errors }}

        <div class="customer-auth__field">
          <label for="recover_email">Correo electrónico</label>
          <input id="recover_email" type="email" name="email" autocomplete="email" required>
        </div>

        <button type="submit" class="customer-auth__submit customer-auth__submit--secondary">Enviar enlace de recuperación</button>
      {% endform %}
    </details>
  </div>
</section>
