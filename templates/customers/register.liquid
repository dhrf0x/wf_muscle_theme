<!-- /templates/customers/register.liquid -->
<div class="customer-page">
  <div class="customer-page__card">

    <p class="customer-page__eyebrow">Mi cuenta</p>
    <h1 class="customer-page__title">Crear cuenta</h1>
    <p class="customer-page__subtitle">Regístrate para un acceso más rápido a tus pedidos.</p>

    {% form 'create_customer', class: 'customer-page' %}
      {{ form.errors | default_errors }}

      <div class="customer-page__field">
        <label class="customer-page__label" for="FirstName">Nombre</label>
        <input
          class="customer-page__input"
          type="text"
          name="customer[first_name]"
          id="FirstName"
          autocomplete="given-name"
          autocapitalize="words"
          placeholder="Tu nombre"
          value="{{ form.first_name }}"
        >
      </div>

      <div class="customer-page__field">
        <label class="customer-page__label" for="LastName">Apellido</label>
        <input
          class="customer-page__input"
          type="text"
          name="customer[last_name]"
          id="LastName"
          autocomplete="family-name"
          autocapitalize="words"
          placeholder="Tu apellido"
          value="{{ form.last_name }}"
        >
      </div>

      <div class="customer-page__field">
        <label class="customer-page__label" for="Email">Correo electrónico</label>
        <input
          class="customer-page__input"
          type="email"
          name="customer[email]"
          id="Email"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          placeholder="tu@correo.com"
          value="{{ form.email }}"
        >
      </div>

      <div class="customer-page__field">
        <label class="customer-page__label" for="CreatePassword">Contraseña</label>
        <input
          class="customer-page__input"
          type="password"
          name="customer[password]"
          id="CreatePassword"
          autocomplete="new-password"
          placeholder="Mínimo 5 caracteres"
        >
      </div>

      <button type="submit" class="customer-page__submit">
        Crear cuenta
      </button>
    {% endform %}

    <div class="customer-page__divider"><span>o</span></div>

    <a href="{{ routes.account_login_url }}" class="customer-page__link-btn">
      Ya tengo cuenta — Iniciar sesión
    </a>

  </div>
</div>
