<section class="customer-auth customer-auth--reset">
  <div class="customer-auth__card">
    <h1 class="customer-auth__title">Restablecer contraseña</h1>

    {% form 'reset_customer_password', class: 'customer-auth__form' %}
      {{ form.errors | default_errors }}

      <div class="customer-auth__field">
        <label for="password">Nueva contraseña</label>
        <input id="password" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="customer-auth__field">
        <label for="password_confirmation">Confirmar contraseña</label>
        <input id="password_confirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="customer-auth__submit">Actualizar contraseña</button>
    {% endform %}
  </div>
</section>
