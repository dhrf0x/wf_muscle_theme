<section class="search-page">
  <div class="search-page__container">
    <h1 class="search-page__title">{{ 'general.search.search' | t | default: 'Buscar' }}</h1>

    {% if search.performed %}
      <p class="search-page__count">{{ search.results_count }} resultados para “{{ search.terms }}”</p>

      {% if search.results_count > 0 %}
        <div class="search-page__grid">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              <a href="{{ item.url }}" class="product-card">
                <div class="product-card-image">
                  {% if item.featured_image %}
                    <img src="{{ item.featured_image | image_url: width: 800, height: 1000, crop: 'center' }}" alt="{{ item.title }}">
                  {% endif %}
                </div>
                <div class="product-card-info">
                  <p class="product-title">{{ item.title }}</p>
                  <p class="product-price">{{ item.price | money }}</p>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <p class="search-empty">Sin resultados para “{{ search.terms }}”.</p>
      {% endif %}
    {% else %}
      <p class="search-empty">Usa el buscador del encabezado para encontrar productos.</p>
    {% endif %}
  </div>
</section>
